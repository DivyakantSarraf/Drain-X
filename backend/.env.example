# ====================================================================
# DRAIN-X Backend Environment Configuration Template
# Copy this file to .env and configure for your local or cloud environment.
# NEVER commit .env with real credentials into source control.
# ====================================================================

APP_NAME="DRAIN-X Predictive Drainage Intelligence"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# System Operational Mode: SIMULATION, PHYSICAL, SAFE_HOLD
SYSTEM_MODE="SIMULATION"
SAFE_HOLD_GATE_ANGLE=0.0

# Server Binding
HOST="0.0.0.0"
PORT=8000

# ====================================================================
# Supabase Cloud Integration (P0.6)
# If left empty, DRAIN-X automatically runs in IN_MEMORY_FALLBACK mode.
# ====================================================================
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=

# Supabase Anon / Public Key (Safe for frontend queries)
SUPABASE_KEY=

# Supabase Service Role Key (BACKEND ONLY - NEVER EXPOSE TO FRONTEND/MOBILE)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (Optional - for local HS256 JWT signature verification)
SUPABASE_JWT_SECRET=

# Enforce JWT authentication on protected operational endpoints (default: False for dev)
SUPABASE_AUTH_ENABLED=False

# Device API Key for ESP32 hardware authentication on /api/v1/telemetry/ingest
# If left blank, open ingestion is permitted for bench testing.
DEVICE_INGEST_API_KEY=

# Supabase PostgREST HTTP timeout (seconds)
PERSISTENCE_TIMEOUT_SEC=3.0

# ====================================================================
# Live Telemetry Stream Settings
# ====================================================================
WS_MAX_CONNECTIONS=100
WS_CLIENT_QUEUE_SIZE=200
WS_HEARTBEAT_INTERVAL_SEC=30.0
STREAM_AUTH_ENABLED=False
STREAM_AUTH_TOKEN=
